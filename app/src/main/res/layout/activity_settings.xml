<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页 v0.56.3：新拟物精修版。外观(深色模式) / 语音(识别语言/灵敏度/自定义指令/个人词典/微信支持) / 反馈(震动) / 服务(无障碍) / 关于；
     根布局套 ScrollView（内容超出屏幕可滚动）。卡片=NeuCardView 真模糊双阴影，
     ScrollView 与内容容器 clipChildren=false 放行越边软阴影 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="返回"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:paddingBottom="20dp">

            <!-- 语音 -->
            <com.voicecontrol.app.NeuCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                app:neuCornerRadius="22dp"
                app:neuBlur="8dp"
                app:neuOffset="4dp"
                app:neuLightColor="@color/neu_hi"
                app:neuDarkColor="@color/neu_lo"
                app:neuSurfaceColor="@color/neu_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:text="语音"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="识别语言"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="普通话"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="识别灵敏度"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_sens_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5（默认推荐）"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:max="9"
                    android:progress="5"
                    android:minHeight="6dp"
                    android:maxHeight="6dp"
                    android:progressDrawable="@drawable/neu_slider_track"
                    android:thumb="@drawable/neu_slider_thumb"
                    android:thumbOffset="0dp"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/tv_sens_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="2dp"
                    android:text="5 为日常推荐 · 9 弱声优化 · 10 远场收音。越高越灵敏，误识别也随之增多；下次会话生效。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_custom_say"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="自定义指令"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="用自己的话下指令"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_custom_vocab"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="个人词典"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人名、地名优先识别"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />
            </com.voicecontrol.app.NeuCardView>

            <!-- 外观 -->
            <com.voicecontrol.app.NeuCardView
                android:id="@+id/card_appearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                app:neuCornerRadius="22dp"
                app:neuBlur="8dp"
                app:neuOffset="4dp"
                app:neuLightColor="@color/neu_hi"
                app:neuDarkColor="@color/neu_lo"
                app:neuSurfaceColor="@color/neu_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:text="外观"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/row_dark_mode"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="深色模式"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_dark_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跟随系统"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.voicecontrol.app.NeuCardView>

            <!-- 反馈 -->
            <com.voicecontrol.app.NeuCardView
                android:id="@+id/card_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                app:neuCornerRadius="22dp"
                app:neuBlur="8dp"
                app:neuOffset="4dp"
                app:neuLightColor="@color/neu_hi"
                app:neuDarkColor="@color/neu_lo"
                app:neuSurfaceColor="@color/neu_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:text="反馈"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="震动反馈"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <Switch
                        android:id="@+id/sw_vibrate"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:track="@drawable/neu_switch_track"
                        android:thumb="@drawable/neu_switch_thumb"
                        android:thumbOffset="2dp"
                        android:textOn=""
                        android:textOff="" />
                </LinearLayout>
            </com.voicecontrol.app.NeuCardView>

            <!-- 服务 -->
            <com.voicecontrol.app.NeuCardView
                android:id="@+id/card_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                app:neuCornerRadius="22dp"
                app:neuBlur="8dp"
                app:neuOffset="4dp"
                app:neuLightColor="@color/neu_hi"
                app:neuDarkColor="@color/neu_lo"
                app:neuSurfaceColor="@color/neu_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:text="服务"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/row_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="无障碍服务"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_a11y_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已开启"
                        android:textColor="#34C759"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.voicecontrol.app.NeuCardView>

            <!-- 备份（v0.49.0）：导出/导入个人配置，换机/重装免重设 -->
            <com.voicecontrol.app.NeuCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                app:neuCornerRadius="22dp"
                app:neuBlur="8dp"
                app:neuOffset="4dp"
                app:neuLightColor="@color/neu_hi"
                app:neuDarkColor="@color/neu_lo"
                app:neuSurfaceColor="@color/neu_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:text="备份"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/row_config_export"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="导出个人配置"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="复制指令/词典/设置"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_config_import"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="导入个人配置"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="粘贴导出的文字恢复"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.voicecontrol.app.NeuCardView>

            <!-- 关于 -->
            <com.voicecontrol.app.NeuCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                app:neuCornerRadius="22dp"
                app:neuBlur="8dp"
                app:neuOffset="4dp"
                app:neuLightColor="@color/neu_hi"
                app:neuDarkColor="@color/neu_lo"
                app:neuSurfaceColor="@color/neu_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:text="关于"
                    android:textColor="@color/text_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <LinearLayout
                    android:id="@+id/row_about"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="关于言出法随"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_coffee"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="请作者喝杯咖啡"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="18dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_contact"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/row_press"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="反馈与联系"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </com.voicecontrol.app.NeuCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

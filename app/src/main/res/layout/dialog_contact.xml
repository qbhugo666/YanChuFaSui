<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="反馈与联系"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="使用中遇到问题，或有功能建议，欢迎联系作者。"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="微信"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HXH2003qb"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_copy_wechat"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="复制微信号 HXH2003qb"
            android:gravity="center"
            android:background="@drawable/row_press"
            android:clickable="true"
            android:focusable="true"
            android:text="复制"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="QQ"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="252206091"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_copy_qq"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="复制 QQ 号 252206091"
            android:gravity="center"
            android:background="@drawable/row_press"
            android:clickable="true"
            android:focusable="true"
            android:text="复制"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/btn_open_github"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/row_press"
        android:clickable="true"
        android:contentDescription="打开言出法随 GitHub 项目，查看源码与版本更新"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="GitHub"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="查看项目源码与更新"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="打开 ↗"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_contact_done"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/row_press"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="关闭"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />
</LinearLayout>
